<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardNotification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/p2_bg_white_card"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical">

    <!-- TYPE ICON BADGE -->
    <TextView
        android:id="@+id/tvNotificationIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/p2_bg_circle"
        android:backgroundTint="#46044B"
        android:gravity="center"
        android:text="🔔"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <!-- TEXT CONTENT -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNotificationTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Alert Title"
                android:textColor="#46044B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNotificationTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:30 AM"
                android:textColor="#8A8397"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvNotificationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Notification message description text."
            android:textColor="#6C5573"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
